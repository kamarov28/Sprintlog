default-lease-time 600;
max-lease-time 7200;
authoritative;

subnet {{ dhcp_subnet }} netmask {{ dhcp_netmask }} {
    range {{ dhcp_range_start }} {{ dhcp_range_end }};
    option routers {{ dhcp_router }};
    option domain-name-servers {{ controller_ip }};
    option domain-name "{{ lab_domain }}";
}

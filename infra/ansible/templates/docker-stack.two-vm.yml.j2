version: "3.8"

x-app-env: &app-env
  APP_NAME: SprintLog
  APP_ENV: production
  APP_KEY: ${APP_KEY}
  APP_DEBUG: "false"
  APP_URL: ${APP_URL:-http://172.20.3.133:8080}
  APP_TIMEZONE: ${APP_TIMEZONE:-Asia/Jakarta}
  TZ: ${TZ:-Asia/Jakarta}
  DB_CONNECTION: mysql
  DB_HOST: ${DB_HOST:-db}
  DB_PORT: "3306"
  DB_DATABASE: sprintlog
  DB_USERNAME: sprintlog
  DB_PASSWORD: ${DB_PASSWORD}
  SESSION_DRIVER: database
  SESSION_SECURE_COOKIE: "false"
  SESSION_SECURE: "false"
  SESSION_SAME_SITE: lax
  TRUSTED_PROXIES: "*"
  CACHE_STORE: database
  QUEUE_CONNECTION: database

services:
  {{ lb_service_name }}:
    image: ${NGINX_LB_IMAGE:-{{ nginx_lb_image }}}
    ports:
      - "${HTTP_PORT:-{{ http_port }}}:80"
    configs:
      - source: nginx_lb_config
        target: /etc/nginx/conf.d/default.conf
    networks:
      - app_net
    deploy:
      replicas: ${LB_REPLICAS:-{{ lb_replicas }}}
      placement:
        constraints:
          - node.hostname == ${SWARM_MANAGER_HOSTNAME:-vm1}
      restart_policy:
        condition: any

  {{ app_service_name }}:
    image: ${SPRINTLOG_IMAGE:-sprintlog-apache:latest}
    environment: *app-env
    networks:
      - app_net
    volumes:
      - app_storage:/var/www/html/storage
    deploy:
      replicas: ${APP_REPLICAS:-{{ app_replicas }}}
      placement:
        constraints:
          - node.hostname == ${SWARM_MANAGER_HOSTNAME:-vm1}
      restart_policy:
        condition: any

  {{ db_service_name }}:
    image: ${MYSQL_IMAGE:-{{ mysql_image }}}
    environment:
      MYSQL_DATABASE: sprintlog
      MYSQL_USER: sprintlog
      MYSQL_PASSWORD: ${DB_PASSWORD}
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD}
    networks:
      - app_net
    volumes:
      - db_data:/var/lib/mysql
    deploy:
      replicas: ${MYSQL_REPLICAS:-{{ mysql_replicas }}}
      placement:
        constraints:
          - node.hostname == ${SWARM_MANAGER_HOSTNAME:-vm1}
      restart_policy:
        condition: any

networks:
  app_net:
    name: ${DOCKER_NETWORK_NAME:-network_ujikom}
    driver: overlay
    attachable: true

volumes:
  db_data:
    name: ${DOCKER_DB_VOLUME_NAME:-db_ujikom}
  app_storage:
    name: ${DOCKER_STORAGE_VOLUME_NAME:-volume_ujikom}

configs:
  nginx_lb_config:
    file: ./nginx-lb.conf
